  <ol class="award-list" id="awardList">
    {(aw.list || []).map((a) => (
      <li class="reveal">
        <span class="award-year">{a.year}</span>
        <span class="award-name">{a.name}<span>{a.sub}</span></span>
      </li>
    ))}
  </ol>
</section>

<!-- ══════════════ SEC.08 求职意向 ══════════════ -->
<section class="section section-tint" id="objective" hidden={RULES.objective === false}>
  <div class="section-head">
    <span class="section-no">{secNo('objective')}</span>
    <h2 class="section-title">求职意向 <span class="title-en">TARGET</span></h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-coord" aria-hidden="true">LOCKED//JOB-PREFS</span>
  </div>
  <div class="obj-grid" id="objGrid">
    {(d.objective?.cards || []).map((c) => (
      <div class={`obj-card ${c.cls || ''} reveal`}>
        <span class="obj-tag">{c.tag}</span>
        {c.role ? (
          <><h3 class="obj-role">{c.role}</h3><p class="obj-role-sub">{c.roleSub}</p></>
        ) : (
          <h3 class="obj-role-sm">{c.roleSm}</h3>
        )}
        <p class="obj-desc">{c.desc}</p>
      </div>
    ))}
