      <h2 class="fp-title" id="peopleTitle">推荐的人 <span class="fp-en">RECOMMENDS</span></h2>
      <p class="fp-note">我认可其作品与判断的同行 · 不是友情链接栏</p>
    </div>
    <div class="fp-grid" id="peopleGrid">
      {peopleList.slice(0, peopleMax).map((p, i) => (
        <a class="fp-card" href={p.site} target="_blank" rel="noopener noreferrer" aria-label={`${p.name}：${p.reason || '推荐的个人站'}`}>
          <span class={`fp-ava fp-c${i % 3}`} aria-hidden="true">{(p.initial || p.name || '').slice(0, 1).toUpperCase()}</span>
          <span class="fp-body">
            <span class="fp-name">{p.name}<i class="fp-arrow" aria-hidden="true">↗</i></span>
            <span class="fp-role">{p.role}</span>
            <span class="fp-reason" title={p.reason || ''}>{p.reason}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" id="footerBrandMark">{d.meta?.brandMark}<span class="brand-dot">.</span></span>
      <span class="footer-tagline" id="footerTagline">{d.meta?.footer?.tagline}</span>
    </div>
    <div class="footer-meta">
      <span id="footerCopyright">{d.meta?.footer?.copyright}</span>
      <span id="eofEgg" title="EOF">FILE END — EOF</span>
      <span class="footer-coord" id="footerCoord">{d.meta?.footer?.coord}</span>
    </div>
    <div class="barcode barcode-sm" aria-hidden="true"></div>
  </div>
</footer>

