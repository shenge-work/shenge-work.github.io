<!-- ══════════════ SEC.09 联系方式 + 简历下载 ══════════════ -->
<section class="section section-contact" id="contact" hidden={RULES.contact === false}>
  <div class="section-head">
    <span class="section-no">{secNo('contact')}</span>
    <h2 class="section-title">联系方式 <span class="title-en">CONTACT</span></h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-coord" aria-hidden="true">SIGNAL//SEND-MESSAGE</span>
  </div>
  <h3 class="contact-big reveal" id="contactBig" set:html={ct.big || ''}></h3>
  <div class="contact-grid" id="contactGrid">
    {(ct.cards || []).map((c) => {
      const inner = <>
        <span class="contact-label">{c.label}</span>
        <span class="contact-value">{c.value}</span>
        {c.mini && <span class="contact-mini">{c.mini}</span>}
        {!c.plain && <span class="pixel-arrow contact-arrow" aria-hidden="true">▶</span>}
      </>;
      const wide = c.span ? ' contact-card-wide' : '';
      if (c.plain || !c.href) {
        return <div class={`contact-card contact-card-plain${wide} reveal`}>{inner}</div>;
      }
      return (
        <a class={`contact-card${wide} reveal`} href={c.href} target={/^https?:/.test(c.href) ? '_blank' : undefined} rel={/^https?:/.test(c.href) ? 'noopener noreferrer' : undefined}>{inner}</a>
      );
    })}
  </div>
  <!-- GitHub 贡献热力图：数据来自 data/contributions.json（Actions 每日刷新），加载失败整块隐藏 -->
  <div class="gh-activity" id="ghActivity" hidden></div>
  <div class="resume-cta reveal" id="resumeCta">
    <div class="resume-cta-text"><strong>{cta.title}</strong><p>{cta.desc}</p></div>
    <a class="btn btn-solid btn-lg" href={cta.resumeFile || 'resume.html'}>{cta.btnDownload} <span class="btn-arrow" aria-hidden="true">▶</span></a>
    <a class="btn btn-ghost btn-lg" href={cta.resumeFile || 'resume.html'} target="_blank">{cta.btnPreview}</a>
  </div>
</section>

<!-- ══════════════ SEC.10 留言墙 / GUEST WALL ══════════════ -->
<section class="section section-tint" id="wall">
  <div class="section-head">
    <span class="section-no">{secNo('wall')}</span>
    <h2 class="section-title">留言墙 <span class="title-en">GUEST WALL</span></h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-coord" aria-hidden="true">SIGNAL//PRIVATE-NOTE</span>
  </div>
  <p class="wall-lead reveal" id="wallLead" set:html={d.wall?.lead || ''}></p>
  <div class="wall-wrap">
    <form class="wall-form reveal" id="wallForm" novalidate>
      <div class="wall-form-head">
        <span class="wall-form-no">POST//NEW</span>
        <span class="wall-form-hint">匿名可选 · 仅本设备可见 · 可继续评论</span>
      </div>
      <input class="wall-input" id="wallName" type="text" maxlength="16" placeholder="怎么称呼你？（可留空 = 匿名）" autocomplete="off" />
      <textarea class="wall-input wall-textarea" id="wallText" maxlength="300" rows="4" placeholder="对我的经历或能力有想法？写在这里，只有这台设备能看到…" required></textarea>
      <!-- 人机校验（Cloudflare Turnstile）：脚本加载失败时保持 hidden，留言照常可用 -->
      <div class="wall-turnstile" id="wallTurnstile" hidden></div>
      <div class="wall-form-foot">
        <span class="wall-count" id="wallCount" aria-live="polite">0 / 300</span>
        <button class="wall-submit" type="submit" id="wallSubmit">写进本设备留言本 ▶</button>
      </div>
      <p class="wall-form-tip" id="wallFormTip">⌘ / Ctrl + Enter 快速提交 · 换行会保留</p>
    </form>
    <div class="wall-board">
      <div class="wall-board-head">
        <span class="wall-board-title">NOTE//THIS-DEVICE</span>
        <span class="wall-board-count" id="wallTotal" aria-live="polite"></span>
        <span class="wall-board-actions">
          <button class="wall-new" type="button" id="wallNew" hidden>有新留言 ▲</button>
          <button class="wall-refresh" type="button" id="wallRefresh" aria-label="刷新留言" title="刷新留言">
            <span class="wall-refresh-icon" aria-hidden="true">↻</span> 刷新
          </button>
        </span>
      </div>
      <div class="wall-list reveal" id="wallList" aria-live="polite"></div>
      <div class="wall-board-foot">
        <button class="wall-more" type="button" id="wallMore" hidden>加载更早的留言 ▼</button>
        <span class="wall-board-note" id="wallNote"></span>
      </div>
    </div>
  </div>
</section>

