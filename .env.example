# ──────────────────────────────────────────────────────────────────────
#  fork 部署参数模板（只含变量名和占位符，绝不放真实密钥）
#  用法：在 Cloudflare Pages → Settings → Environment variables 里逐项填写；
#        本地 pages dev 可复制为 .dev.vars（已 gitignore）。
# ──────────────────────────────────────────────────────────────────────

# 必填：会话签名盐（32 字节以上）
ADMIN_SESSION_SECRET=

# 必填：允许登录后台的邮箱，逗号分隔
ADMIN_EMAILS=you@example.com

# 发验证码 / 留言通知 / 简历投递
RESEND_API_KEY=
RESEND_FROM=
# 四类发件身份的代码默认值都是原站域名，fork 后请覆盖成自己的已验证发件身份：
#   后台验证码 ADMIN_EMAIL_FROM  （默认 code@chenpeisheng.cn）
#   留言通知   WALL_NOTIFY_FROM  （默认 wall@chenpeisheng.cn）
#   简历投递   DELIVER_FROM      （默认 jobs@chenpeisheng.cn）
#   访问验证   VERIFY_ACCESS_FROM（见下方，默认 access@chenpeisheng.cn）
ADMIN_EMAIL_FROM=
DELIVER_FROM=
DELIVER_BCC=

# 必填：设备指纹 HMAC pepper（fork 必须换成自己的随机串）
DEVICE_HASH_PEPPER=

# 核验链接签名 / 投递挑战 / 留言校验
VERIFY_ACCESS_SECRET=
VERIFY_ACCESS_TO=
VERIFY_ACCESS_FROM=

# 加密材料（离职证明等）签名链接密钥；不配则沿用 VERIFY_ACCESS_SECRET 加命名空间。
# 签名链接默认 5 分钟失效，前端自动续签；原件只存私有 KV / COS，不下发裸地址。
SECURE_ASSET_SECRET=
# 可选：改用腾讯云 COS 私有对象存原件（桶为 public-read 时必须单对象 ACL=private）
# 上传：TMP_SECRET_ID / TMP_SECRET_KEY / TMP_TOKEN（临时密钥）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_BUCKET=
COS_REGION=
COS_PRIVATE_PREFIX=
DELIVER_CHALLENGE_SECRET=
DELIVER_POW_DIFFICULTY=4
TURNSTILE_SECRET=
WALL_NOTIFY_TO=
WALL_NOTIFY_FROM=

# RAG / AI：KB Worker 地址与共享令牌（语义检索必需）
#   知识库重建也走这个 Worker（POST /rebuild），不需要 CI 里的 API Token。
KB_WORKER_URL=
KB_TOKEN=
# 可选兜底：Pages 里没绑 AI 时，/api/kb 直接用 REST 调 Workers AI + Vectorize
CF_API_TOKEN=
CF_ACCOUNT_ID=

# 可选登录方式（不用就留空）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_LOGIN_ENABLED=0
WECHAT_ALLOW_OPENIDS=
WECHAT_ALLOW_UNIONIDS=
ADMIN_PASSWORD=
WALL_ADMIN_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USERS=

# 部署参数（改成你自己的域名；代码内置默认值仅适用于原站）
ALLOWED_ORIGINS=https://your-domain.example
MAIN_SITE_URL=https://your-domain.example

# 语音合成走原站云函数；自建可覆盖
TTS_ENDPOINT=

# 预览环境（可选）：wrangler.toml 的 [env.preview] 必须指向独立 D1 / KV，
# 否则预览部署会退回生产绑定、把真实数据暴露在预览站上。
# 预览只配 ADMIN_EMAILS + 自签的 ADMIN_SESSION_SECRET / DEVICE_HASH_PEPPER /
# VERIFY_ACCESS_SECRET；RESEND / TURNSTILE / 微信 / KB_WORKER_URL 一律不配。

# Cloudflare 绑定（不是环境变量，需在控制台创建并在 wrangler.toml 对应）
#   DB        → D1 数据库（bash scripts/db-init.sh remote 创建）
#   SITE_KV   → KV 命名空间（登录票据 / 限流兜底）
#   AI        → Workers AI（query embedding）
#   VECTORIZE → Vectorize 索引 resume-kb（语义向量）
